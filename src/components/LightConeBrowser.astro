---
import { Image } from 'astro:assets';

import type { AssetImage } from '../utils/item-assets';
import { t } from '../utils/i18n';

type LightConeBrowserData = {
  rarities: number[];

  paths: {
    id: string;
    label: string;
  }[];

  lightCones: {
    id: string;
    image: AssetImage | '';
    name: string;
    rarity: number;

    path: string;
    pathLabel: string;

    versionReleased: string;
    sourceName: string;

    level1Hp: string;
    levelMaxHp: string;

    level1Atk: string;
    levelMaxAtk: string;

    level1Def: string;
    levelMaxDef: string;

    passivePanels: {
      superimposition: number;
      html: string;
    }[];
  }[];
};

const { data, locale } = Astro.props as {
  data: LightConeBrowserData;
  locale: any;
};

const allLabel = t(locale, 'ui', 'All', undefined, false);
const resultsLabel = t(locale, 'ui', 'Results', undefined, false);

const noResultsLabel = t(
  locale,
  'ui',
  'No light cones found',
  undefined,
  false,
);

const sourceLabel = t(
  locale,
  'ui',
  'Source',
  undefined,
  false,
);

const searchByNameLabel = t(
  locale,
  'ui',
  'Search by name',
  undefined,
  false,
);

const lightConeLabel = t(
  locale,
  'ui',
  'Light Cone',
  undefined,
  false,
);

const pathLabel = t(
  locale,
  'ui',
  'Path',
  undefined,
  false,
);

const rarityLabel = t(
  locale,
  'ui',
  'Rarity',
  undefined,
  false,
);

const searchLabel = t(
  locale,
  'ui',
  'Search',
  undefined,
  false,
);

const descriptionLabel = t(
  locale,
  'ui',
  'Description',
  undefined,
  false,
);

const level1Label = t(
  locale,
  'ui',
  'Level 1',
  undefined,
  false,
);

const maxLevelLabel = t(
  locale,
  'ui',
  'Max Level',
  undefined,
  false,
);

const statLabel = t(
  locale,
  'ui',
  'Stat',
  undefined,
  false,
);

const sortByLabel = t(
  locale,
  'ui',
  'Sort by',
  undefined,
  false,
);

const releaseDateLabel = t(
  locale,
  'ui',
  'Release date',
  undefined,
  false,
);

const newestLabel = t(
  locale,
  'ui',
  'Newest',
  undefined,
  false,
);

const sortOptions = [
  {
    value: 'name',
    label: `${lightConeLabel} - A-Z`,
  },
  {
    value: 'release',
    label: `${releaseDateLabel} - ${newestLabel}`,
  },
];
---

<section
  class="weapon-browser"
  data-light-cone-browser
>
  <form
    class="home-filters weapon-filters"
    id="light-cone-filters"
    data-light-cone-filters
  >
    <label class="home-search">
      {searchLabel}

      <input
        type="search"
        name="search"
        placeholder={searchByNameLabel}
        autocomplete="off"
      />
    </label>

    <div class="home-select-filter">
      {pathLabel}

      <select
        class="home-native-select"
        name="path"
        aria-label={pathLabel}
      >
        <option value="">
          {allLabel}
        </option>

        {
          data.paths.map((path) => (
            <option value={path.id}>
              {path.label}
            </option>
          ))
        }
      </select>
    </div>

    <div class="home-select-filter">
      {rarityLabel}

      <select
        class="home-native-select"
        name="rarity"
        aria-label={rarityLabel}
      >
        <option value="">
          {allLabel}
        </option>

        {
          data.rarities.map((rarity) => (
            <option value={String(rarity)}>
              {rarity}
              {'\u2605'}
            </option>
          ))
        }
      </select>
    </div>
  </form>

  <div class="weapon-browser-header">
    <p
      data-light-cone-count
      data-results-label={resultsLabel}
      aria-live="polite"
    >
      {data.lightCones.length}
      {' '}
      {resultsLabel}
    </p>

    <label class="roster-sort">
      {sortByLabel}

      <select
        class="home-native-select"
        name="sort"
        form="light-cone-filters"
        aria-label={sortByLabel}
      >
        {
          sortOptions.map((option) => (
            <option
              value={option.value}
              selected={option.value === 'name'}
            >
              {option.label}
            </option>
          ))
        }
      </select>
    </label>
  </div>

  <div class="weapon-grid">
    {
      data.lightCones.map((lightCone) => (
        <article
          class={`weapon-entry rarity-${lightCone.rarity}`}
          data-light-cone-card
          data-name={lightCone.name}
          data-rarity={lightCone.rarity}
          data-path={lightCone.path}
          data-version-released={lightCone.versionReleased}
        >
          <header class="weapon-entry-header">
            <div class="weapon-entry-title">
              <div
                class={`weapon-entry-image${
                  lightCone.image ? '' : ' is-empty'
                }`}
              >
                {lightCone.image && (
                  <Image
                    src={lightCone.image}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    width={72}
                    height={72}
                    densities={[1, 2]}
                  />
                )}
              </div>

              <div>
                <h2>{lightCone.name}</h2>
                <p>{lightCone.pathLabel}</p>
              </div>
            </div>

            <span class="weapon-entry-rarity">
              {lightCone.rarity}
              {'\u2605'}
            </span>
          </header>

          <table class="weapon-stat-table">
            <thead>
              <tr>
                <th>{statLabel}</th>
                <th>{level1Label}</th>
                <th>{maxLevelLabel}</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <th scope="row">HP</th>
                <td>{lightCone.level1Hp || '-'}</td>
                <td>{lightCone.levelMaxHp || '-'}</td>
              </tr>

              <tr>
                <th scope="row">ATK</th>
                <td>{lightCone.level1Atk || '-'}</td>
                <td>{lightCone.levelMaxAtk || '-'}</td>
              </tr>

              <tr>
                <th scope="row">DEF</th>
                <td>{lightCone.level1Def || '-'}</td>
                <td>{lightCone.levelMaxDef || '-'}</td>
              </tr>
            </tbody>
          </table>

          {lightCone.passivePanels.length > 0 && (
            <section
              class="weapon-entry-passive"
              aria-label={`${lightCone.name} ${descriptionLabel}`}
            >
              <div class="weapon-entry-section-header">
                <h3>{descriptionLabel}</h3>

                <div class="weapon-refinement-buttons">
                  {lightCone.passivePanels.map((panel) => (
                    <button
                      class="weapon-refinement-button"
                      type="button"
                      data-light-cone-superimposition={`s${panel.superimposition}`}
                      aria-pressed={
                        panel.superimposition === 1
                          ? 'true'
                          : 'false'
                      }
                    >
                      S{panel.superimposition}
                    </button>
                  ))}
                </div>
              </div>

              <div class="weapon-passive-copy">
                {lightCone.passivePanels.map((panel) => (
                  <div
                    data-light-cone-superimposition-panel={`s${panel.superimposition}`}
                    hidden={panel.superimposition !== 1}
                    set:html={panel.html}
                  />
                ))}
              </div>
            </section>
          )}

          <footer class="weapon-entry-footer">
            <span>{sourceLabel}</span>
            <strong>{lightCone.sourceName || '-'}</strong>
          </footer>
        </article>
      ))
    }
  </div>

  <p
    class="weapon-empty"
    data-light-cone-empty
    hidden
  >
    {noResultsLabel}
  </p>
</section>

<script>
  import '../scripts/card-filters';
</script>