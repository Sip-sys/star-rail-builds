---
import { t } from '../utils/i18n';

const { locale, recentlyUpdatedCount = 0 } = Astro.props;
const hasRecentUpdates = recentlyUpdatedCount > 0;
const recentlyUpdatedLabel = t(
    locale,
    'ui',
    'Recently updated',
    undefined,
    false,
);
const versionText = t(locale, 'ui', 'Last 2 versions', undefined, false);

// Filter options mirror metadata values written onto each character card.
const elements = [
    'physical',
    'fire',
    'ice',
    'lightning',
    'wind',
    'quantum',
    'imaginary',
];
const rarities = ['4', '5'];
const paths = [
    'destruction',
    'hunt',
    'erudition',
    'harmony',
    'nihility',
    'preservation',
    'abundance',
    'remembrance',
    'elation',
];
const allLabel = t(locale, 'ui', 'All');

const elementOptions = [
    { value: '', label: allLabel },
    ...elements.map((element) => ({
        value: element,
        label: t(locale, 'element', element),
    })),
];
const rarityOptions = [
    { value: '', label: allLabel },
    ...rarities.map((rarity) => ({
        value: rarity,
        label: `${rarity}\u2605`,
    })),
];
const pathOptions = [
    { value: '', label: allLabel },
    ...paths.map((path) => ({
        value: path,
        label: t(locale, 'path', path),
    })),
];
---

<form class="home-filters" id="character-filters" data-character-filters>
    <label class="home-search">
        {t(locale, 'ui', 'Search')}
        <input
            type="search"
            name="search"
            placeholder={t(locale, 'ui', 'Search by name')}
            autocomplete="off"
        />
    </label>

    <div class="home-select-filter">
        {t(locale, 'ui', 'Element')}
        <select
            class="home-native-select"
            name="element"
            aria-label={t(locale, 'ui', 'Element')}
        >
            {
                elementOptions.map((option) => (
                    <option value={option.value}>{option.label}</option>
                ))
            }
        </select>
    </div>

    <div class="home-select-filter">
        {t(locale, 'ui', 'Rarity')}
        <select
            class="home-native-select"
            name="rarity"
            aria-label={t(locale, 'ui', 'Rarity')}
        >
            {
                rarityOptions.map((option) => (
                    <option value={option.value}>{option.label}</option>
                ))
            }
        </select>
    </div>

    <div class="home-select-filter">
        {t(locale, 'ui', 'Path')}
        <select
            class="home-native-select"
            name="path"
            aria-label={t(locale, 'ui', 'Path')}
        >
            {
                pathOptions.map((option) => (
                    <option value={option.value}>{option.label}</option>
                ))
            }
        </select>
    </div>

    {
        hasRecentUpdates && (
            <label class="home-updated-toggle">
                <input
                    class="home-updated-toggle-input"
                    type="checkbox"
                    name="updated"
                    value="true"
                />
                <span class="home-updated-toggle-mark" aria-hidden="true" />
                <span class="home-updated-text">
                    <span class="home-updated-toggle-title">
                        {recentlyUpdatedLabel}
                    </span>
                    {versionText && (
                        <span class="home-updated-toggle-version">
                            {versionText}
                        </span>
                    )}
                </span>
                <span class="home-updated-toggle-count">
                    {recentlyUpdatedCount}
                </span>
            </label>
        )
    }
</form>
